APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000
MAX_ITERATIONS=3
QUERY_TIMEOUT_SECONDS=15
RESULT_ROW_LIMIT=100
ALLOWED_DATABASE_IDS=demo

# Required only when a Graph node creates the real OpenAI-compatible client.
OPENAI_API_KEY=
# Optional: leave blank for OpenAI's default API endpoint.
OPENAI_BASE_URL=
# Required: set the model name accepted by the selected provider.
OPENAI_MODEL=
