# 应用运行环境：local / test / production
APP_ENV=local
# 服务监听地址
APP_HOST=127.0.0.1
# 服务监听端口
APP_PORT=8000
# Agent 最大迭代次数
MAX_ITERATIONS=3
# 查询超时时间（秒）
QUERY_TIMEOUT_SECONDS=15
# 单次查询最多返回的结果行数
RESULT_ROW_LIMIT=100
# 是否启用结果摘要生成
RESULT_SUMMARY_ENABLED=true
# 结果摘要允许处理的最大字符数
RESULT_SUMMARY_MAX_CHARS=12000
# 意图识别结果可直接采用的最低置信度
INTENT_CONFIDENCE_THRESHOLD=0.75
# 演示 SQLite 数据库文件路径
DEMO_DATABASE_PATH=data/demo.sqlite

# OpenAI 兼容模型服务 API 密钥
OPENAI_API_KEY=
# OpenAI 兼容模型服务地址
OPENAI_BASE_URL=
# 使用的模型名称
OPENAI_MODEL=

# LangSmith / LangGraph 链路追踪配置；设为 true 时上报运行记录
LANGSMITH_TRACING=false
# LangSmith 服务地址
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LangSmith API 密钥
LANGSMITH_API_KEY=
# LangSmith 项目名称
LANGSMITH_PROJECT=chain-nl2sql

# Schema 检索模式：hybrid / vector / bm25
SCHEMA_RETRIEVAL_MODE=hybrid
# Schema 检索索引存储目录
SCHEMA_INDEX_ROOT=data/schema_metadata_runtime
# 每次 Schema 检索返回的候选数量
SCHEMA_TOP_K=5
# 检索不可用时的降级模式
SCHEMA_FALLBACK_MODE=bm25
# Schema 向量检索使用的嵌入模型
SCHEMA_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# Schema 候选重排序模型
SCHEMA_RERANKER_MODEL=BAAI/bge-reranker-base

# 会话数据库文件路径
CONVERSATION_DATABASE_PATH=data/conversations.sqlite3
# 会话上下文最大字符数
CONVERSATION_CONTEXT_MAX_CHARS=6000

# 知识库原始文件存储目录
KNOWLEDGE_ROOT=data/knowledge
# 知识库 SQLite 数据库文件路径
KNOWLEDGE_DATABASE_PATH=data/knowledge.sqlite3
# 每次知识库检索返回的候选数量
KNOWLEDGE_TOP_K=5
# 单个知识库文件最大上传大小（字节）
KNOWLEDGE_MAX_UPLOAD_BYTES=20971520
# 知识库文本分块大小（字符）
KNOWLEDGE_CHUNK_SIZE=800
# 相邻知识库文本分块重叠字符数
KNOWLEDGE_CHUNK_OVERLAP=120

# 应用登录用户名
APP_AUTH_USERNAME=admin
# 应用登录密码
APP_AUTH_PASSWORD=xxxxxx
# 应用会话签名密钥；生产环境应替换为随机长字符串
APP_SESSION_SECRET=change-this-to-a-long-random-value
# 登录会话有效期（秒）
APP_SESSION_MAX_AGE_SECONDS=1209600
